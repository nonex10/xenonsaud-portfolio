# Copy this file to ".env" (same folder) and fill in your real values.
# NEVER commit ".env" to GitHub. On Render, add these same names under Environment Variables.

# Needed everywhere
CONTACT_RECEIVER_EMAIL=where.you.want.messages@gmail.com
# Local testing: http://localhost:5173   |   Live site: https://your-portfolio.vercel.app (no slash at the end)
FRONTEND_URL=http://localhost:5173

# LOCAL testing with Gmail (not used if RESEND_API_KEY is set)
SMTP_EMAIL=your.gmail.address@gmail.com
SMTP_APP_PASSWORD=your-16-character-gmail-app-password

# LIVE site on Render: use Resend instead (Render's free plan blocks Gmail SMTP)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
